---
import Icon from "./Icon.astro";
import { services, site } from "../data/site";

const { hero } = site;
const [lineOne, lineTwo] = hero.headline;
const secondaryCta =
  services.length > 0
    ? hero.secondaryCta
    : { href: "#kontakt", label: hero.primaryCta.label };
---

<section
  class="relative isolate flex min-h-[100svh] items-center overflow-hidden pt-[var(--nav-h)]"
  aria-labelledby="hero-title"
>
  <canvas
    data-energy-field
    class="pointer-events-auto absolute inset-0 -z-20 size-full"
    aria-hidden="true"></canvas>

  <div class="grid-lines absolute inset-0 -z-30 opacity-60" aria-hidden="true"></div>

  <div
    class="absolute inset-0 -z-30 bg-[radial-gradient(ellipse_80%_60%_at_50%_-10%,rgba(30,239,242,0.18),transparent_70%)]"
    aria-hidden="true"
  >
  </div>

  <div
    class="bg-volt-500/10 absolute -bottom-40 -left-40 -z-30 size-[34rem] rounded-full blur-[120px]"
    aria-hidden="true"
  >
  </div>

  <div
    class="from-ink-950 absolute inset-x-0 bottom-0 -z-10 h-40 bg-linear-to-t to-transparent"
    aria-hidden="true"
  >
  </div>

  <div class="container-x relative py-16 md:py-24">
    <div
      class="pointer-events-none mx-auto max-w-3xl text-center [&_a]:pointer-events-auto"
    >
      {
        site.tagline && (
          <p class="eyebrow justify-center" data-reveal>
            {site.name} · {site.tagline}
          </p>
        )
      }
      {
        !site.tagline && (
          <p class="eyebrow justify-center" data-reveal>
            {site.name}
          </p>
        )
      }

      <h1
        id="hero-title"
        class="mt-6 text-[clamp(2.75rem,7.5vw,5.25rem)] leading-[0.95] font-bold"
      >
        <span class="block" data-reveal style="--reveal-delay:80ms">{lineOne}</span>
        {
          lineTwo && (
            <span
              class="text-gradient block bg-[length:200%_auto]"
              data-reveal
              style="--reveal-delay:200ms"
            >
              {lineTwo}
            </span>
          )
        }
      </h1>

      {
        hero.lead && (
          <p
            class="text-ink-400 mx-auto mt-7 max-w-xl text-lg leading-relaxed md:text-xl"
            data-reveal
            style="--reveal-delay:320ms"
          >
            {hero.lead}
          </p>
        )
      }

      <div
        class="mt-10 flex flex-wrap items-center justify-center gap-4"
        data-reveal
        style="--reveal-delay:420ms"
      >
        <a
          href={hero.primaryCta.href}
          class="group bg-brand-400 text-ink-950 shadow-brand-400/25 hover:shadow-brand-400/40 relative inline-flex items-center gap-2 overflow-hidden rounded-full px-7 py-4 text-base font-semibold shadow-xl transition-shadow duration-300"
          data-magnetic
          data-magnetic-strength="0.22"
        >
          <span class="relative z-10">{hero.primaryCta.label}</span>
          <Icon
            name="arrow"
            class="relative z-10 size-4 transition-transform duration-300 group-hover:translate-x-1"
          />
          <span
            class="absolute inset-0 -translate-x-full bg-linear-to-r from-transparent via-white/50 to-transparent transition-transform duration-700 group-hover:translate-x-full"
          ></span>
        </a>

        {
          services.length > 0 && (
            <a
              href={secondaryCta.href}
              class="glass text-ink-50 hover:border-brand-400/40 inline-flex items-center gap-2 rounded-full px-7 py-4 text-base font-semibold transition-colors duration-300"
            >
              {secondaryCta.label}
            </a>
          )
        }
      </div>

      {
        hero.trust.length > 0 && (
          <ul
            class="text-ink-400 mt-10 flex flex-wrap items-center justify-center gap-x-7 gap-y-3 text-sm"
            data-reveal
            style="--reveal-delay:520ms"
          >
            {hero.trust.map((item) => (
              <li class="flex items-center gap-2">
                <Icon name={item.icon} class="text-brand-400 size-4" />
                {item.text}
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </div>

  <a
    href={services.length > 0 ? "#leistungen" : "#kontakt"}
    class="text-ink-500 hover:text-brand-300 absolute bottom-6 left-1/2 hidden -translate-x-1/2 flex-col items-center gap-2 text-[0.7rem] tracking-[0.25em] uppercase transition-colors md:flex"
    aria-label="Weiter scrollen"
  >
    Scrollen
    <span class="relative block h-10 w-px overflow-hidden bg-white/12">
      <span
        class="bg-brand-400 absolute inset-x-0 top-0 h-4"
        style="animation: scroll-hint 2.2s ease-in-out infinite"></span>
    </span>
  </a>
</section>

<style>
  @keyframes scroll-hint {
    0% {
      transform: translateY(-100%);
    }
    60%,
    100% {
      transform: translateY(250%);
    }
  }
</style>
