---
import Icon from "./Icon.astro";
import Marquee from "./Marquee.astro";
import AlarmDemo from "./AlarmDemo.astro";
import { site } from "../data/site";

const trust = [
  { icon: "clock" as const, text: "Antwort in einem Werktag" },
  { icon: "check" as const, text: "Unverbindliche Beratung" },
  { icon: "shield" as const, text: "Lokal statt Cloud" },
];
---

<section
  class="relative isolate flex min-h-[100svh] flex-col overflow-x-clip pt-[var(--nav-h)] lg:min-h-[100svh]"
  aria-labelledby="hero-title"
>
  <!-- Hintergrundebenen -->
  <canvas
    data-energy-field
    class="pointer-events-auto absolute inset-0 -z-20 size-full"
    aria-hidden="true"></canvas>

  <div class="grid-lines absolute inset-0 -z-30 opacity-60" aria-hidden="true"></div>

  <div
    class="absolute inset-0 -z-30 bg-[radial-gradient(ellipse_80%_60%_at_50%_-10%,rgba(30,239,242,0.18),transparent_70%)]"
    aria-hidden="true"
  >
  </div>

  <div
    class="bg-volt-500/10 absolute -bottom-40 -left-40 -z-30 size-[34rem] rounded-full blur-[120px]"
    aria-hidden="true"
  >
  </div>

  <div
    class="from-ink-950 pointer-events-none absolute inset-x-0 bottom-0 -z-10 h-40 bg-linear-to-t to-transparent"
    aria-hidden="true"
  >
  </div>

  <div
    class="container-x relative flex min-h-0 flex-1 items-center py-8 md:py-12 lg:py-16"
  >
    <div
      class="grid w-full items-center gap-10 md:grid-cols-[1.05fr_0.95fr] md:gap-8 lg:gap-10"
    >
      <!-- Text -->
      <div class="pointer-events-none max-w-2xl [&_a]:pointer-events-auto">
        <p class="eyebrow" data-reveal>
          {site.name} · {site.tagline}
        </p>

        <h1
          id="hero-title"
          class="mt-6 text-[clamp(2.75rem,7.5vw,5.25rem)] leading-[0.95] font-bold"
        >
          <span class="block" data-reveal style="--reveal-delay:80ms"
            >Dein Zuhause,</span
          >
          <span
            class="text-gradient block bg-[length:200%_auto]"
            data-reveal
            style="--reveal-delay:200ms"
          >
            gesichert und vernetzt.
          </span>
        </h1>

        <p
          class="text-ink-400 mt-7 max-w-xl text-lg leading-relaxed md:text-xl"
          data-reveal
          style="--reveal-delay:320ms"
        >
          Alarmanlagen und IT aus einer Hand: geplant, eingerichtet und betreut. Von
          Geiselwind aus für Würzburg, Kitzingen und Umgebung.
        </p>

        <div
          class="mt-10 flex flex-wrap items-center gap-4"
          data-reveal
          style="--reveal-delay:420ms"
        >
          <a
            href="#kontakt"
            class="group bg-brand-400 text-ink-950 shadow-brand-400/25 hover:shadow-brand-400/40 relative inline-flex items-center gap-2 overflow-hidden rounded-full px-7 py-4 text-base font-semibold shadow-xl transition-shadow duration-300"
            data-magnetic
            data-magnetic-strength="0.22"
          >
            <span class="relative z-10">Beratung anfragen</span>
            <Icon
              name="arrow"
              class="relative z-10 size-4 transition-transform duration-300 group-hover:translate-x-1"
            />
            <span
              class="absolute inset-0 -translate-x-full bg-linear-to-r from-transparent via-white/50 to-transparent transition-transform duration-700 group-hover:translate-x-full"
            ></span>
          </a>

          <a
            href="#leistungen"
            class="glass text-ink-50 hover:border-brand-400/40 inline-flex items-center gap-2 rounded-full px-7 py-4 text-base font-semibold transition-colors duration-300"
          >
            Leistungen ansehen
          </a>
        </div>

        <ul
          class="text-ink-400 mt-10 flex flex-wrap items-center gap-x-7 gap-y-3 text-sm"
          data-reveal
          style="--reveal-delay:520ms"
        >
          {
            trust.map((item) => (
              <li class="flex items-center gap-2">
                <Icon name={item.icon} class="text-brand-400 size-4" />
                {item.text}
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Interaktive Demo -->
      <div class="relative" data-reveal style="--reveal-delay:260ms">
        <div
          class="bg-brand-400/10 absolute -inset-6 rounded-[2.5rem] blur-3xl"
          aria-hidden="true"
        >
        </div>
        <AlarmDemo />
      </div>
    </div>
  </div>

  <a
    href="#leistungen"
    class="text-ink-500 hover:text-brand-300 relative z-10 mx-auto mb-3 flex min-h-11 flex-col items-center justify-center gap-2 text-[0.7rem] tracking-[0.25em] uppercase transition-colors"
    aria-label="Scrollen, weiter zu den Leistungen"
  >
    Scrollen
    <span class="relative block h-8 w-px overflow-hidden bg-white/12">
      <span
        class="bg-brand-400 absolute inset-x-0 top-0 h-4"
        style="animation: scroll-hint 2.2s ease-in-out infinite"></span>
    </span>
  </a>

  <Marquee />
</section>

<style>
  @keyframes scroll-hint {
    0% {
      transform: translateY(-100%);
    }
    60%,
    100% {
      transform: translateY(250%);
    }
  }
</style>

<script>
  import "../scripts/alarm-demo";
</script>
