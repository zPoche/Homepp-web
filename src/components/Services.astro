---
import Icon from "./Icon.astro";
import { services, site } from "../data/site";

const accentClasses: Record<string, string> = {
  brand: "text-brand-400 from-brand-400/20",
  volt: "text-volt-400 from-volt-400/20",
  signal: "text-signal-400 from-signal-400/20",
};

const intro = site.servicesIntro;
---

{
  services.length > 0 && (
    <section id="leistungen" class="relative scroll-mt-24 py-24 md:py-32">
      <div class="container-x">
        <div class="max-w-3xl">
          <p class="eyebrow" data-reveal>
            {intro.eyebrow}
          </p>
          <h2
            class="mt-5 text-[clamp(2rem,4.5vw,3.5rem)] leading-[1.05] font-bold"
            data-reveal
            style="--reveal-delay:80ms"
          >
            {intro.titleBefore}
            {intro.titleHighlight && (
              <>
                {" "}
                <span class="text-highlight">{intro.titleHighlight}</span>
              </>
            )}
            {intro.titleAfter ? ` ${intro.titleAfter}` : ""}
          </h2>
          {intro.lead && (
            <p
              class="text-ink-400 mt-6 text-lg leading-relaxed"
              data-reveal
              style="--reveal-delay:160ms"
            >
              {intro.lead}
            </p>
          )}
        </div>

        <ul class="mt-14 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {services.map((service, i) => (
            <li data-reveal style={`--reveal-delay:${i * 70}ms`}>
              <article class="glass spotlight group relative flex h-full flex-col rounded-3xl p-7 transition-all duration-500 hover:-translate-y-1.5 hover:border-white/16">
                <span
                  class={`inline-flex size-12 items-center justify-center rounded-2xl bg-linear-to-br ${accentClasses[service.accent]} to-transparent`}
                >
                  <Icon
                    name={service.icon}
                    class={`size-5 ${accentClasses[service.accent].split(" ")[0]}`}
                  />
                </span>
                <h3 class="font-display mt-5 text-xl font-semibold">{service.title}</h3>
                <p class="text-ink-400 mt-2 text-sm leading-relaxed">
                  {service.teaser}
                </p>
                <p class="text-ink-500 mt-3 flex-1 text-sm leading-relaxed">
                  {service.description}
                </p>
                <ul class="text-ink-400 mt-5 space-y-2 text-sm">
                  {service.bullets.map((bullet) => (
                    <li class="flex gap-2">
                      <Icon
                        name="check"
                        class="text-brand-400 mt-0.5 size-3.5 shrink-0"
                      />
                      <span>{bullet}</span>
                    </li>
                  ))}
                </ul>
              </article>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )
}
