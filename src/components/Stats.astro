---
import { stats } from "../data/site";
---

<section class="relative py-16" aria-label="Zahlen und Fakten">
  <div class="container-x">
    <dl
      class="glass grid gap-px overflow-hidden rounded-3xl sm:grid-cols-2 lg:grid-cols-4"
    >
      {
        stats.map((stat, i) => (
          <div
            class="hover:bg-brand-400/4 px-7 py-9 text-center transition-colors duration-500"
            data-reveal
            style={`--reveal-delay:${i * 90}ms`}
          >
            <dt class="sr-only">{stat.label}</dt>
            <dd>
              <span class="font-display text-highlight block text-[clamp(2.5rem,5vw,3.5rem)] leading-none font-bold">
                <span data-counter={stat.value}>0</span>
                <span>{stat.suffix}</span>
              </span>
              <span class="text-ink-400 mt-3 block text-sm leading-snug">
                {stat.label}
              </span>
            </dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>
