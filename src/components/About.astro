---
import Icon from "./Icon.astro";
import { site } from "../data/site";

const { about } = site;
const hasContent = Boolean(about.text || about.highlights.length);
---

{
  hasContent && (
    <section id="ueber-uns" class="relative scroll-mt-24 py-24 md:py-32">
      <div class="container-x">
        <div class="mx-auto max-w-3xl">
          <p class="eyebrow" data-reveal>
            {about.eyebrow}
          </p>
          <h2
            class="mt-5 text-[clamp(2rem,4.5vw,3.5rem)] leading-[1.05] font-bold"
            data-reveal
            style="--reveal-delay:80ms"
          >
            {about.title}
            {about.highlight && (
              <>
                {" "}
                <span class="text-highlight">{about.highlight}</span>
              </>
            )}
          </h2>
          {about.text && (
            <p
              class="text-ink-400 mt-6 text-lg leading-relaxed"
              data-reveal
              style="--reveal-delay:140ms"
            >
              {about.text}
            </p>
          )}

          {about.highlights.length > 0 && (
            <dl class="mt-10 space-y-6">
              {about.highlights.map((item, i) => (
                <div
                  class="grid grid-cols-[auto_1fr] items-start gap-x-4"
                  data-reveal
                  style={`--reveal-delay:${200 + i * 90}ms`}
                >
                  <span
                    class="bg-brand-400/10 text-brand-400 ring-brand-400/20 row-span-2 mt-0.5 inline-flex size-9 shrink-0 items-center justify-center rounded-xl ring-1"
                    aria-hidden="true"
                  >
                    <Icon name="spark" class="size-4" />
                  </span>
                  <dt class="font-display text-lg font-semibold">{item.title}</dt>
                  <dd class="text-ink-400 mt-1.5 leading-relaxed">{item.text}</dd>
                </div>
              ))}
            </dl>
          )}
        </div>
      </div>
    </section>
  )
}
