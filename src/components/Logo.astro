---
interface Props {
  class?: string;
  /** Kompakte Marke statt Wordmark – für enge Flächen */
  mark?: boolean;
}
const { class: className = "h-9 md:h-11", mark = false } = Astro.props;

const src = mark ? "/brand/logo-mark.png" : "/brand/logo-wordmark.png";
const width = mark ? 120 : 520;
const height = mark ? 120 : 96;
---

{
  /*
  Logos aus public/brand/. Der zugängliche Name steht im alt-Text –
  der umgebende Link braucht kein zusätzliches aria-label.
*/
}
<img
  src={src}
  width={width}
  height={height}
  alt="Bootlabs"
  class={`w-auto ${className}`}
  decoding="async"
/>
