---
interface Props {
  class?: string;
}
const { class: className = "" } = Astro.props;
---

{
  /* inline-flex verwirft den Zeilenumbruch zwischen den Spans, die Wortmarke
    bleibt dadurch optisch zusammen. Kein aria-label und kein sr-only-Text:
    der zugängliche Name soll exakt dem entsprechen, was zu sehen ist. */
}
<span
  class={`font-display inline-flex items-start leading-none font-bold tracking-tight select-none ${className}`}
>
  <span class="text-white">Home</span>
  <span class="text-brand-400">Power</span>
  <span class="text-brand-400 relative -top-[0.35em] text-[0.62em] leading-none">
    +
  </span>
</span>
