---
interface Props {
  class?: string;
  /** Kompakte HP+-Marke statt Wordmark – für enge Flächen */
  mark?: boolean;
}
const { class: className = "h-7 md:h-8", mark = false } = Astro.props;

const src = mark ? "/brand/logo-mark.png" : "/brand/logo-wordmark.png";
const width = mark ? 120 : 520;
const height = mark ? 120 : 96;
---

{
  /*
  Original-Logos aus public/brand/. Der zugängliche Name steht im alt-Text –
  der umgebende Link braucht kein zusätzliches aria-label.
*/
}
<img
  src={src}
  width={width}
  height={height}
  alt="HomePower+"
  class={`w-auto ${className}`}
  decoding="async"
/>
