---
import { demo } from "../data/site";
---

<div
  class="glass relative rounded-[1.75rem] p-5 shadow-2xl shadow-black/40 sm:p-6"
  data-parallax="0.05"
  data-alarm-demo
  data-copy={JSON.stringify(demo)}
>
  <div class="flex items-start justify-between gap-3">
    <div class="min-w-0">
      <p class="text-ink-500 text-xs font-medium tracking-widest uppercase">
        {demo.label}
      </p>
      <p class="font-display mt-1 text-xl font-semibold">{demo.title}</p>
    </div>
    <span
      class="text-brand-300 border-brand-400/25 bg-brand-400/10 relative inline-flex shrink-0 items-center gap-2 rounded-full border px-3 py-1.5 text-xs font-semibold"
      data-demo-status-wrap
    >
      <span class="relative flex size-2">
        <span
          class="bg-brand-400 absolute inline-flex size-full rounded-full"
          data-demo-status-ring
          style="animation: pulse-ring 2s ease-out infinite"></span>
        <span class="bg-brand-400 relative inline-flex size-2 rounded-full"></span>
      </span>
      <span data-demo-status>{demo.status.disarmed}</span>
    </span>
  </div>

  <p class="text-ink-500 mt-3 text-xs">{demo.hint}</p>

  <div
    class="mt-4 grid grid-cols-2 gap-1 rounded-full border border-white/8 bg-white/3 p-1"
    role="tablist"
    aria-label="Demo-Ansicht"
  >
    <button
      type="button"
      role="tab"
      id="demo-tab-alarm"
      aria-controls="demo-panel-alarm"
      aria-selected="true"
      class="min-h-11 rounded-full px-3 text-sm font-semibold"
      data-demo-tab="alarm"
    >
      {demo.tabs.alarm}
    </button>
    <button
      type="button"
      role="tab"
      id="demo-tab-video"
      aria-controls="demo-panel-video"
      aria-selected="false"
      class="text-ink-400 min-h-11 rounded-full px-3 text-sm font-semibold"
      data-demo-tab="video"
    >
      {demo.tabs.video}
    </button>
  </div>

  <div class="mt-5 grid items-start gap-5 sm:grid-cols-2 sm:gap-4">
    <div>
      <div
        class="demo-stage relative rounded-2xl border border-white/10 bg-[#0c121c]"
        data-demo-house
      >
        <div class="demo-scene">
          <div class="demo-model">
            <svg
              class="demo-house-svg"
              viewBox="0 0 250 228"
              role="img"
              aria-label="Einfamilienhaus mit Satteldach. Tür und Fenster sind anklickbar."
            >
              <defs>
                <linearGradient id="demo-wall-front" x1="0" y1="0" x2="0" y2="1">
                  <stop offset="0" stop-color="#d5dde6"></stop>
                  <stop offset="0.55" stop-color="#b7c2ce"></stop>
                  <stop offset="1" stop-color="#8e9aaa"></stop>
                </linearGradient>
                <linearGradient id="demo-wall-side" x1="0" y1="0" x2="1" y2="1">
                  <stop offset="0" stop-color="#7b8898"></stop>
                  <stop offset="1" stop-color="#3b4656"></stop>
                </linearGradient>
                <linearGradient id="demo-roof-r" x1="0" y1="0" x2="0.9" y2="1">
                  <stop offset="0" stop-color="#5d738c"></stop>
                  <stop offset="0.4" stop-color="#2a3a4e"></stop>
                  <stop offset="1" stop-color="#121820"></stop>
                </linearGradient>
                <linearGradient id="demo-roof-l" x1="1" y1="0" x2="0" y2="1">
                  <stop offset="0" stop-color="#6d8298"></stop>
                  <stop offset="1" stop-color="#1d2836"></stop>
                </linearGradient>
                <linearGradient id="demo-open-fill" x1="0" y1="0" x2="0" y2="1">
                  <stop offset="0" stop-color="#1eeff2" stop-opacity="0.55"></stop>
                  <stop offset="1" stop-color="#0a3036"></stop>
                </linearGradient>
                <linearGradient id="demo-porch" x1="0" y1="0" x2="0" y2="1">
                  <stop offset="0" stop-color="#4a5d73"></stop>
                  <stop offset="1" stop-color="#1b2430"></stop>
                </linearGradient>
                <pattern
                  id="demo-tiles-r"
                  width="9"
                  height="6"
                  patternUnits="userSpaceOnUse"
                  patternTransform="rotate(36 0 0)"
                >
                  <path
                    d="M0 5.4 H9"
                    fill="none"
                    stroke="#05080d"
                    stroke-opacity="0.45"
                    stroke-width="0.7"></path>
                  <path
                    d="M0 2 H9"
                    fill="none"
                    stroke="#1eeff2"
                    stroke-opacity="0.07"
                    stroke-width="0.6"></path>
                </pattern>
                <pattern
                  id="demo-tiles-l"
                  width="9"
                  height="6"
                  patternUnits="userSpaceOnUse"
                  patternTransform="rotate(-32 0 0)"
                >
                  <path
                    d="M0 5.4 H9"
                    fill="none"
                    stroke="#05080d"
                    stroke-opacity="0.35"
                    stroke-width="0.7"></path>
                </pattern>
                <filter id="demo-soft" x="-20%" y="-20%" width="140%" height="140%">
                  <feGaussianBlur stdDeviation="1.1"></feGaussianBlur>
                </filter>
              </defs>

              <ellipse
                cx="128"
                cy="214"
                rx="112"
                ry="12"
                fill="rgb(0 0 0 / 0.5)"
                filter="url(#demo-soft)"></ellipse>
              <path
                d="M40 214 C72 226 128 230 168 220 C130 228 70 224 36 214 Z"
                fill="#161d28"></path>

              <g>
                <ellipse cx="22" cy="204" rx="17" ry="10" fill="#142822"></ellipse>
                <ellipse cx="14" cy="201" rx="10" ry="8" fill="#1a332c"></ellipse>
                <ellipse cx="30" cy="200" rx="9" ry="7" fill="#18302a"></ellipse>
              </g>
              <g>
                <ellipse cx="226" cy="176" rx="16" ry="9" fill="#142822"></ellipse>
                <ellipse cx="218" cy="173" rx="9" ry="7" fill="#1a332c"></ellipse>
              </g>

              <polygon
                points="80.2,181.4 218.2,181.4 218.2,103.4 80.2,103.4"
                fill="#1c2532"></polygon>
              <polygon
                points="166,212 218.2,181.4 218.2,103.4 166,134"
                fill="url(#demo-wall-side)"
                stroke="#1eeff2"
                stroke-opacity="0.12"
                stroke-width="0.9"></polygon>
              <polygon
                points="28,212 166,212 166,134 97,76 28,134"
                fill="url(#demo-wall-front)"
                stroke="#edf4fa"
                stroke-opacity="0.35"
                stroke-width="0.8"></polygon>
              <polygon
                points="28,212 166,212 166,200 28,200"
                fill="#5c6b7c"
                opacity="0.38"></polygon>

              <polygon
                points="91.2,79.4 155,42 76,100 12.2,137.4"
                fill="url(#demo-roof-l)"
                stroke="#9aafc2"
                stroke-opacity="0.22"
                stroke-width="0.9"></polygon>
              <polygon
                points="91.2,79.4 155,42 76,100 12.2,137.4"
                fill="url(#demo-tiles-l)"></polygon>
              <polygon
                points="91.2,79.4 170.2,137.4 234,100 155,42"
                fill="url(#demo-roof-r)"
                stroke="#1eeff2"
                stroke-opacity="0.16"
                stroke-width="1"></polygon>
              <polygon
                points="91.2,79.4 170.2,137.4 234,100 155,42"
                fill="url(#demo-tiles-r)"></polygon>
              <path
                d="M91.2 79.4 L155 42"
                fill="none"
                stroke="#0a0f17"
                stroke-width="3.2"
                stroke-linecap="round"></path>
              <path
                d="M28 134 L97 76 L166 134"
                fill="none"
                stroke="#121820"
                stroke-width="3.4"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
              <path
                d="M170.2 137.4 L234 100"
                fill="none"
                stroke="#8aa0b4"
                stroke-opacity="0.35"
                stroke-width="2.2"
                stroke-linecap="round"></path>
              <path
                d="M166 136 L166 200"
                fill="none"
                stroke="#6d7d8c"
                stroke-opacity="0.7"
                stroke-width="1.4"></path>

              <polygon points="145,87.3 159,87.3 168.3,81.9 154.3,81.9" fill="#0e141c"
              ></polygon>
              <polygon points="145,87.3 159,87.3 159,36 145,36" fill="#7b8c9d"
              ></polygon>
              <polygon points="159,87.3 168.3,81.9 168.3,32 159,36" fill="#3d4a5c"
              ></polygon>
              <polygon
                points="143,36 157,36 166.3,30 152.3,30"
                fill="#10161e"
                stroke="#1eeff2"
                stroke-opacity="0.18"
                stroke-width="0.8"></polygon>

              <circle
                cx="97"
                cy="112"
                r="8.5"
                fill="#0c3338"
                stroke="#5cf1f7"
                stroke-width="1.7"></circle>
              <path
                d="M97 104.2 V119.8 M89.2 112 H104.8"
                fill="none"
                stroke="#5cf1f7"
                stroke-opacity="0.75"
                stroke-width="1.1"></path>

              <polygon
                points="181.1,175.2 198.5,165 198.5,139 181.1,149.2"
                fill="#0c3338"
                stroke="#5cf1f7"
                stroke-width="1.6"></polygon>
              <path
                d="M189.8 170.1 V144.1 M181.1 162.2 L198.5 152"
                fill="none"
                stroke="#5cf1f7"
                stroke-opacity="0.7"
                stroke-width="1"></path>

              <polygon
                points="43,153 81,153 81,212 43,212"
                fill="#1a222c"
                stroke="#5cf1f7"
                stroke-width="1.4"></polygon>
              <polygon points="46,156 78,156 78,212 46,212" fill="url(#demo-open-fill)"
              ></polygon>
              <polygon
                points="105,153 149,153 149,186 105,186"
                fill="#1a222c"
                stroke="#5cf1f7"
                stroke-width="1.4"></polygon>
              <polygon
                points="108,156 146,156 146,186 108,186"
                fill="url(#demo-open-fill)"></polygon>
              <polygon points="102.3,186 148.3,186 150,190 101,190" fill="#243044"
              ></polygon>

              <polygon
                points="35.4,148.7 81.4,148.7 90.6,143.3 44.6,143.3"
                fill="url(#demo-porch)"></polygon>
              <polygon
                points="35.4,148.7 81.4,148.7 81.4,153.7 35.4,153.7"
                fill="#1b2430"></polygon>
              <circle cx="60.7" cy="155.4" r="2.1" fill="#1eeff2" opacity="0.85"
              ></circle>

              <polygon
                points="38.5,216 78.5,216 73.9,218.8 33.9,218.8"
                fill="#10161e"
                stroke="#1eeff2"
                stroke-opacity="0.16"
                stroke-width="0.8"></polygon>
              <polygon points="42,212 74,212 78.5,216 38.5,216" fill="#1b2430"
              ></polygon>

              <g class="demo-siren" data-demo-siren>
                <rect
                  x="30"
                  y="124"
                  width="12"
                  height="9"
                  rx="1.6"
                  fill="#111823"
                  stroke="#1eeff2"
                  stroke-width="1.2"></rect>
                <ellipse
                  class="demo-siren-glow"
                  cx="36"
                  cy="124"
                  rx="5.4"
                  ry="3.1"
                  fill="rgb(30 239 242 / 0.55)"></ellipse>
              </g>
              <g class="demo-tx">
                <rect
                  x="202"
                  y="158"
                  width="11"
                  height="15"
                  rx="1.4"
                  fill="#111823"
                  stroke="#8a97a6"
                  stroke-width="1.1"></rect>
                <path d="M207.5 158 V148" stroke="#8a97a6" stroke-width="1.3"></path>
                <circle cx="207.5" cy="147" r="1.6" fill="#8a97a6"></circle>
              </g>
              <g class="demo-camera-mark">
                <rect
                  x="136"
                  y="128"
                  width="16"
                  height="9"
                  rx="1.8"
                  fill="#111823"
                  stroke="#1eeff2"
                  stroke-width="1.2"></rect>
                <circle cx="147.5" cy="132.5" r="2.3" fill="#1eeff2"></circle>
              </g>
            </svg>

            <button
              type="button"
              class="demo-door"
              data-demo-door
              aria-pressed="false"
              aria-label={demo.house.doorClosed}
            >
              <span class="demo-opening" aria-hidden="true"></span>
              <span class="demo-leaf demo-door-leaf" data-door-leaf></span>
            </button>
            <button
              type="button"
              class="demo-window"
              data-demo-window
              aria-pressed="false"
              aria-label={demo.house.windowClosed}
            >
              <span class="demo-opening" aria-hidden="true"></span>
              <span class="demo-leaf demo-window-leaf" data-window-leaf></span>
            </button>
            <button
              type="button"
              class="demo-camera"
              data-demo-camera
              aria-label={demo.house.camera}
            >
            </button>
          </div>
        </div>
      </div>

      <div class="mt-3 flex flex-wrap gap-2">
        <button
          type="button"
          class="glass hover:border-brand-400/40 min-h-11 rounded-full px-3.5 text-xs font-semibold"
          data-demo-door
          aria-pressed="false"
        >
          {demo.house.doorClosed}
        </button>
        <button
          type="button"
          class="glass hover:border-brand-400/40 min-h-11 rounded-full px-3.5 text-xs font-semibold"
          data-demo-window
          aria-pressed="false"
        >
          {demo.house.windowClosed}
        </button>
      </div>

      <p class="text-ink-500 mt-3 flex flex-wrap gap-x-3 gap-y-1 text-[0.7rem]">
        <span data-demo-siren-label>{demo.house.sirenIdle}</span>
        <span data-demo-tx-label>{demo.house.txIdle}</span>
      </p>
    </div>

    <div>
      <div id="demo-panel-alarm" role="tabpanel" aria-labelledby="demo-tab-alarm">
        <button
          type="button"
          class="bg-brand-400 text-ink-950 min-h-11 w-full rounded-full px-4 text-sm font-semibold"
          data-demo-arm
          aria-pressed="false"
        >
          {demo.arm}
        </button>

        <p
          class="text-ink-500 mt-4 text-[0.7rem] font-semibold tracking-widest uppercase"
        >
          Meldungen
        </p>
        <ul
          class="mt-2 max-h-40 space-y-1.5 overflow-y-auto pr-1"
          data-demo-log
          aria-live="polite"
        >
          <li class="text-ink-500 text-xs leading-relaxed">{demo.logEmpty}</li>
        </ul>

        <button
          type="button"
          class="glass mt-3 hidden min-h-11 w-full rounded-full px-4 text-sm font-semibold"
          data-demo-ack
        >
          {demo.ack}
        </button>
      </div>

      <div
        id="demo-panel-video"
        class="hidden"
        role="tabpanel"
        aria-labelledby="demo-tab-video"
        hidden
      >
        <div class="grid grid-cols-[1fr_auto] items-start gap-3">
          <div
            class="relative aspect-[4/3] overflow-hidden rounded-2xl border border-white/8 bg-[#0a0f17]"
            data-demo-live
          >
            <div
              class="from-brand-400/15 absolute inset-0 bg-linear-to-b to-transparent"
            >
            </div>
            <p
              class="text-ink-500 absolute top-2 left-2 text-[0.65rem] tracking-widest uppercase"
            >
              {demo.video.live}
            </p>
            <p
              class="text-ink-400 absolute inset-x-3 bottom-3 text-center text-[0.7rem] leading-relaxed"
              data-demo-live-caption
            >
              {demo.video.idle}
            </p>
            <div
              class="absolute inset-0 hidden"
              data-demo-overlay="person"
              aria-hidden="true"
            >
              <div
                class="border-brand-400/70 bg-brand-400/20 absolute bottom-5 left-1/2 h-16 w-10 -translate-x-1/2 rounded-t-full border"
              >
              </div>
              <span
                class="border-brand-400/50 text-brand-300 absolute top-8 left-3 rounded border px-1.5 py-0.5 text-[0.6rem]"
                >{demo.video.personOverlay}</span
              >
            </div>
            <div
              class="absolute inset-0 hidden"
              data-demo-overlay="face"
              aria-hidden="true"
            >
              <div
                class="border-brand-400/80 absolute top-8 left-1/2 size-12 -translate-x-1/2 rounded-full border-2"
              >
              </div>
              <span
                class="border-brand-400/50 text-brand-300 absolute top-6 right-3 rounded border px-1.5 py-0.5 text-[0.6rem]"
                >{demo.video.faceOverlay}</span
              >
            </div>
            <div
              class="absolute inset-0 hidden"
              data-demo-overlay="plate"
              aria-hidden="true"
            >
              <div
                class="border-signal-400/70 bg-signal-400/15 absolute bottom-4 left-1/2 h-8 w-16 -translate-x-1/2 rounded-sm border"
              >
              </div>
              <span
                class="bg-signal-400 text-ink-950 absolute bottom-5 left-1/2 -translate-x-1/2 rounded px-1 text-[0.55rem] font-semibold"
                >{demo.video.plateOverlay}</span
              >
            </div>
          </div>

          <div
            class="w-[4.6rem] shrink-0 rounded-[1.1rem] border border-white/10 bg-[#05080d] px-1.5 pt-2 pb-1.5"
            aria-hidden="true"
          >
            <div class="mx-auto mb-1 h-1 w-6 rounded-full bg-white/15"></div>
            <div
              class="min-h-24 rounded-lg border border-white/8 bg-[#111823] px-1.5 py-2"
            >
              <p
                class="text-brand-300 text-[0.55rem] leading-tight font-semibold"
                data-demo-app-title
              >
                {demo.video.appTitle}
              </p>
              <p
                class="text-ink-400 mt-1 text-[0.55rem] leading-snug"
                data-demo-app-body
              >
                {demo.video.appIdle}
              </p>
            </div>
          </div>
        </div>

        <div class="mt-3 flex flex-wrap gap-2">
          <button
            type="button"
            class="glass hover:border-brand-400/40 min-h-11 rounded-full px-3.5 text-xs font-semibold"
            data-demo-detect="person"
          >
            {demo.video.person}
          </button>
          <button
            type="button"
            class="glass hover:border-brand-400/40 min-h-11 rounded-full px-3.5 text-xs font-semibold"
            data-demo-detect="face"
          >
            {demo.video.face}
          </button>
          <button
            type="button"
            class="glass hover:border-brand-400/40 min-h-11 rounded-full px-3.5 text-xs font-semibold"
            data-demo-detect="plate"
          >
            {demo.video.plate}
          </button>
          <button
            type="button"
            class="glass hover:border-brand-400/40 min-h-11 rounded-full px-3.5 text-xs font-semibold"
            data-demo-camera
          >
            {demo.house.camera}
          </button>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .demo-stage {
    overflow: hidden;
  }

  .demo-scene {
    position: relative;
    padding: 0.55rem 0.3rem 0.9rem;
  }

  .demo-model {
    position: relative;
    width: min(100%, 24rem);
    margin-inline: auto;
  }

  .demo-house-svg {
    display: block;
    width: 100%;
    height: auto;
  }

  .demo-door,
  .demo-window,
  .demo-camera {
    position: absolute;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: pointer;
  }

  .demo-door,
  .demo-window {
    transform-style: preserve-3d;
    perspective: 420px;
  }

  .demo-door {
    left: 18.4%;
    top: 68.42%;
    width: 12.8%;
    height: 24.56%;
  }

  .demo-window {
    left: 43.2%;
    top: 68.42%;
    width: 15.2%;
    height: 13.16%;
  }

  .demo-camera {
    left: 54.4%;
    top: 56.14%;
    width: 6.4%;
    height: 3.95%;
  }

  .demo-opening {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgb(30 239 242 / 0.55) 0%, #0a3036 100%);
    box-shadow: inset 0 0 10px rgb(30 239 242 / 0.28);
  }

  .demo-leaf {
    position: absolute;
    inset: 0;
    transform-origin: left center;
    transform-style: preserve-3d;
    transition: transform 0.55s var(--ease-out-expo);
    box-shadow: 0 10px 18px rgb(0 0 0 / 0.4);
  }

  .demo-leaf::before {
    content: "";
    position: absolute;
    top: 0;
    left: 100%;
    width: 0.42rem;
    height: 100%;
    background: #0a0f17;
    transform: rotateY(90deg);
    transform-origin: left center;
  }

  .demo-door-leaf {
    background:
      linear-gradient(#5cf1f7, #5cf1f7) 50% 32% / 62% 1px no-repeat,
      linear-gradient(#5cf1f7, #5cf1f7) 50% 68% / 62% 1px no-repeat,
      linear-gradient(90deg, #141b26 0%, #2a3648 70%, #1b2430 100%);
    border: 2px solid #5cf1f7;
  }

  .demo-door-leaf::after {
    content: "";
    position: absolute;
    top: 50%;
    right: 0.22rem;
    width: 0.42rem;
    height: 0.14rem;
    border-radius: 0.08rem;
    background: #1eeff2;
    transform: translateY(-50%);
  }

  .demo-window-leaf {
    background:
      linear-gradient(rgb(92 241 247 / 0.55), rgb(92 241 247 / 0.55)) center / 1px 100%
        no-repeat,
      linear-gradient(rgb(92 241 247 / 0.55), rgb(92 241 247 / 0.55)) center / 100% 1px
        no-repeat,
      linear-gradient(180deg, rgb(30 239 242 / 0.2), #0c3338);
    border: 2px solid #5cf1f7;
  }

  .demo-door:hover .demo-door-leaf,
  .demo-window:hover .demo-window-leaf {
    filter: brightness(1.14);
  }

  [data-alarm-demo][data-door-open] .demo-door-leaf {
    transform: rotateY(76deg);
  }

  [data-alarm-demo][data-window-open] .demo-window-leaf {
    transform: rotateY(68deg);
  }

  [data-alarm-demo][data-alarm] .demo-siren rect {
    stroke: #ffb545;
  }

  [data-alarm-demo][data-alarm] .demo-siren-glow {
    fill: #ffb545;
  }

  [data-alarm-demo][data-sending] .demo-tx rect,
  [data-alarm-demo][data-sending] .demo-tx path {
    stroke: #1eeff2;
  }

  [data-alarm-demo][data-alarm] [data-demo-status-wrap] {
    color: var(--color-signal-400);
    border-color: rgb(255 181 69 / 0.4);
    background: rgb(255 181 69 / 0.12);
  }

  [data-demo-tab][aria-selected="true"] {
    background: var(--color-brand-400);
    color: var(--color-ink-950);
  }

  @media (prefers-reduced-motion: reduce) {
    .demo-leaf {
      transition: none;
    }
  }
</style>
