---
import { demo } from "../data/site";
---

<div
  class="glass relative rounded-[1.75rem] p-5 shadow-2xl shadow-black/40 sm:p-6"
  data-parallax="0.05"
  data-alarm-demo
  data-copy={JSON.stringify(demo)}
>
  <div class="flex items-start justify-between gap-3">
    <div class="min-w-0">
      <p class="text-ink-500 text-xs font-medium tracking-widest uppercase">
        {demo.label}
      </p>
      <p class="font-display mt-1 text-xl font-semibold">{demo.title}</p>
    </div>
    <span
      class="text-brand-300 border-brand-400/25 bg-brand-400/10 relative inline-flex shrink-0 items-center gap-2 rounded-full border px-3 py-1.5 text-xs font-semibold"
      data-demo-status-wrap
    >
      <span class="relative flex size-2">
        <span
          class="bg-brand-400 absolute inline-flex size-full rounded-full"
          data-demo-status-ring
          style="animation: pulse-ring 2s ease-out infinite"></span>
        <span class="bg-brand-400 relative inline-flex size-2 rounded-full"></span>
      </span>
      <span data-demo-status>{demo.status.disarmed}</span>
    </span>
  </div>

  <p class="text-ink-500 mt-3 text-xs">{demo.hint}</p>

  <div
    class="mt-4 grid grid-cols-2 gap-1 rounded-full border border-white/8 bg-white/3 p-1"
    role="tablist"
    aria-label="Demo-Ansicht"
  >
    <button
      type="button"
      role="tab"
      id="demo-tab-alarm"
      aria-controls="demo-panel-alarm"
      aria-selected="true"
      class="min-h-11 rounded-full px-3 text-sm font-semibold"
      data-demo-tab="alarm"
    >
      {demo.tabs.alarm}
    </button>
    <button
      type="button"
      role="tab"
      id="demo-tab-video"
      aria-controls="demo-panel-video"
      aria-selected="false"
      class="text-ink-400 min-h-11 rounded-full px-3 text-sm font-semibold"
      data-demo-tab="video"
    >
      {demo.tabs.video}
    </button>
  </div>

  <div class="mt-5 grid items-start gap-5 sm:grid-cols-2 sm:gap-4">
    <div>
      <div
        class="demo-stage relative rounded-2xl border border-white/10 bg-[#0c121c]"
        data-demo-house
      >
        <div class="demo-scene">
          <div class="demo-model">
            <svg
              class="demo-house-svg"
              viewBox="0 0 270 226"
              role="img"
              aria-label="Einfamilienhaus mit Satteldach. Tür und Fenster sind anklickbar."
            >
              <defs>
                <linearGradient id="demo-wall-front" x1="0" y1="0" x2="0" y2="1">
                  <stop offset="0" stop-color="#c5d0dc"></stop>
                  <stop offset="1" stop-color="#8b97a8"></stop>
                </linearGradient>
                <linearGradient id="demo-wall-side" x1="0" y1="0" x2="1" y2="1">
                  <stop offset="0" stop-color="#6d7b8d"></stop>
                  <stop offset="1" stop-color="#3d4a5c"></stop>
                </linearGradient>
                <linearGradient id="demo-roof-r" x1="0" y1="0" x2="1" y2="1">
                  <stop offset="0" stop-color="#4a5d73"></stop>
                  <stop offset="0.45" stop-color="#243044"></stop>
                  <stop offset="1" stop-color="#141b26"></stop>
                </linearGradient>
                <linearGradient id="demo-roof-l" x1="1" y1="0" x2="0" y2="1">
                  <stop offset="0" stop-color="#5a6e84"></stop>
                  <stop offset="1" stop-color="#1b2430"></stop>
                </linearGradient>
                <pattern
                  id="demo-tiles"
                  width="10"
                  height="7"
                  patternUnits="userSpaceOnUse"
                  patternTransform="rotate(-32 0 0)"
                >
                  <path
                    d="M0 6.2 H10"
                    fill="none"
                    stroke="#1eeff2"
                    stroke-opacity="0.09"
                    stroke-width="0.7"></path>
                  <path
                    d="M0 2.2 H10"
                    fill="none"
                    stroke="#05080d"
                    stroke-opacity="0.35"
                    stroke-width="0.6"></path>
                </pattern>
                <linearGradient id="demo-open-fill" x1="0" y1="0" x2="0" y2="1">
                  <stop offset="0" stop-color="#1eeff2"></stop>
                  <stop offset="1" stop-color="#0a3a40"></stop>
                </linearGradient>
              </defs>

              <ellipse
                class="demo-ground"
                cx="138"
                cy="210"
                rx="118"
                ry="16"
                fill="rgb(0 0 0 / 0.55)"></ellipse>
              <path
                d="M58 201 C72 216 118 222 148 218 C120 224 64 218 52 204 Z"
                fill="#1b2430"></path>
              <ellipse cx="32" cy="200" rx="16" ry="9" fill="#1a2c28"></ellipse>
              <ellipse cx="22" cy="204" rx="10" ry="6" fill="#152420"></ellipse>
              <ellipse cx="236" cy="176" rx="18" ry="9" fill="#1a2c28"></ellipse>

              <polygon points="103,162 235,166 235,84 103,80" fill="#243044"></polygon>
              <polygon
                points="176,202 235,166 235,84 176,120"
                fill="url(#demo-wall-side)"
                stroke="#1eeff2"
                stroke-opacity="0.16"
                stroke-width="1"></polygon>
              <polygon
                points="44,198 176,202 176,120 110,58 44,116"
                fill="url(#demo-wall-front)"
                stroke="#1eeff2"
                stroke-opacity="0.22"
                stroke-width="1.1"></polygon>
              <polygon
                points="44,198 176,202 176,190 44,186"
                fill="#5c6b7d"
                opacity="0.45"></polygon>

              <polygon
                points="110,58 169,22 103,80 44,116"
                fill="url(#demo-roof-l)"
                stroke="#8aa0b6"
                stroke-opacity="0.28"
                stroke-width="1"></polygon>
              <polygon
                points="110,58 176,120 235,84 169,22"
                fill="url(#demo-roof-r)"
                stroke="#1eeff2"
                stroke-opacity="0.2"
                stroke-width="1.1"></polygon>
              <polygon points="110,58 176,120 235,84 169,22" fill="url(#demo-tiles)"
              ></polygon>
              <path
                d="M110 58 L169 22"
                fill="none"
                stroke="#0a0f17"
                stroke-width="3"
                stroke-linecap="round"></path>
              <path
                d="M44 116 L110 58 L176 120"
                fill="none"
                stroke="#0f1724"
                stroke-width="3.2"
                stroke-linecap="round"></path>

              <polygon points="168,70 185,73 185,18 168,16" fill="#6b7d90"></polygon>
              <polygon points="185,73 198,64 198,12 185,18" fill="#3d4a5c"></polygon>
              <polygon
                points="166,16 183,18 196,10 179,8"
                fill="#121820"
                stroke="#1eeff2"
                stroke-opacity="0.2"
                stroke-width="0.8"></polygon>

              <circle
                cx="110"
                cy="86"
                r="8"
                fill="#0e3a42"
                stroke="#5cf1f7"
                stroke-width="1.6"></circle>
              <path
                d="M110 78 V94 M102 86 H118"
                fill="none"
                stroke="#5cf1f7"
                stroke-opacity="0.7"
                stroke-width="1"></path>

              <polygon
                points="195,133 214,121 214,149 195,161"
                fill="#0e3a42"
                stroke="#5cf1f7"
                stroke-width="1.5"></polygon>
              <path
                d="M204.5 127 V155 M195 147 L214 135"
                fill="none"
                stroke="#5cf1f7"
                stroke-opacity="0.65"
                stroke-width="1"></path>

              <polygon points="58,200 97,202 102,208 53,206" fill="#121820"></polygon>
              <polygon points="63,143 91,145 91,201 63,199" fill="url(#demo-open-fill)"
              ></polygon>
              <polygon
                points="127,141 161,142 161,170 127,169"
                fill="url(#demo-open-fill)"></polygon>

              <g class="demo-siren" data-demo-siren>
                <rect
                  x="46"
                  y="104"
                  width="11"
                  height="9"
                  rx="1.5"
                  fill="#111823"
                  stroke="#1eeff2"
                  stroke-width="1.2"></rect>
                <ellipse
                  class="demo-siren-glow"
                  cx="51.5"
                  cy="104"
                  rx="5"
                  ry="3"
                  fill="rgb(30 239 242 / 0.55)"></ellipse>
              </g>
              <g class="demo-tx">
                <rect
                  x="218"
                  y="148"
                  width="10"
                  height="14"
                  rx="1.2"
                  fill="#111823"
                  stroke="#8a97a6"
                  stroke-width="1.1"></rect>
                <path d="M223 148 V140" stroke="#8a97a6" stroke-width="1.2"></path>
              </g>
            </svg>

            <button
              type="button"
              class="demo-door"
              data-demo-door
              aria-pressed="false"
              aria-label={demo.house.doorClosed}
            >
              <span class="demo-opening" aria-hidden="true"></span>
              <span class="demo-leaf demo-door-leaf" data-door-leaf></span>
            </button>
            <button
              type="button"
              class="demo-window"
              data-demo-window
              aria-pressed="false"
              aria-label={demo.house.windowClosed}
            >
              <span class="demo-opening" aria-hidden="true"></span>
              <span class="demo-leaf demo-window-leaf" data-window-leaf></span>
            </button>
            <button
              type="button"
              class="demo-camera"
              data-demo-camera
              aria-label={demo.house.camera}
            >
            </button>
          </div>
        </div>
      </div>

      <div class="mt-3 flex flex-wrap gap-2">
        <button
          type="button"
          class="glass hover:border-brand-400/40 min-h-11 rounded-full px-3.5 text-xs font-semibold"
          data-demo-door
          aria-pressed="false"
        >
          {demo.house.doorClosed}
        </button>
        <button
          type="button"
          class="glass hover:border-brand-400/40 min-h-11 rounded-full px-3.5 text-xs font-semibold"
          data-demo-window
          aria-pressed="false"
        >
          {demo.house.windowClosed}
        </button>
      </div>

      <p class="text-ink-500 mt-3 flex flex-wrap gap-x-3 gap-y-1 text-[0.7rem]">
        <span data-demo-siren-label>{demo.house.sirenIdle}</span>
        <span data-demo-tx-label>{demo.house.txIdle}</span>
      </p>
    </div>

    <div>
      <div id="demo-panel-alarm" role="tabpanel" aria-labelledby="demo-tab-alarm">
        <button
          type="button"
          class="bg-brand-400 text-ink-950 min-h-11 w-full rounded-full px-4 text-sm font-semibold"
          data-demo-arm
          aria-pressed="false"
        >
          {demo.arm}
        </button>

        <p
          class="text-ink-500 mt-4 text-[0.7rem] font-semibold tracking-widest uppercase"
        >
          Meldungen
        </p>
        <ul
          class="mt-2 max-h-40 space-y-1.5 overflow-y-auto pr-1"
          data-demo-log
          aria-live="polite"
        >
          <li class="text-ink-500 text-xs leading-relaxed">{demo.logEmpty}</li>
        </ul>

        <button
          type="button"
          class="glass mt-3 hidden min-h-11 w-full rounded-full px-4 text-sm font-semibold"
          data-demo-ack
        >
          {demo.ack}
        </button>
      </div>

      <div
        id="demo-panel-video"
        class="hidden"
        role="tabpanel"
        aria-labelledby="demo-tab-video"
        hidden
      >
        <div class="grid grid-cols-[1fr_auto] items-start gap-3">
          <div
            class="relative aspect-[4/3] overflow-hidden rounded-2xl border border-white/8 bg-[#0a0f17]"
            data-demo-live
          >
            <div
              class="from-brand-400/15 absolute inset-0 bg-linear-to-b to-transparent"
            >
            </div>
            <p
              class="text-ink-500 absolute top-2 left-2 text-[0.65rem] tracking-widest uppercase"
            >
              {demo.video.live}
            </p>
            <p
              class="text-ink-400 absolute inset-x-3 bottom-3 text-center text-[0.7rem] leading-relaxed"
              data-demo-live-caption
            >
              {demo.video.idle}
            </p>
            <div
              class="absolute inset-0 hidden"
              data-demo-overlay="person"
              aria-hidden="true"
            >
              <div
                class="border-brand-400/70 bg-brand-400/20 absolute bottom-5 left-1/2 h-16 w-10 -translate-x-1/2 rounded-t-full border"
              >
              </div>
              <span
                class="border-brand-400/50 text-brand-300 absolute top-8 left-3 rounded border px-1.5 py-0.5 text-[0.6rem]"
                >{demo.video.personOverlay}</span
              >
            </div>
            <div
              class="absolute inset-0 hidden"
              data-demo-overlay="face"
              aria-hidden="true"
            >
              <div
                class="border-brand-400/80 absolute top-8 left-1/2 size-12 -translate-x-1/2 rounded-full border-2"
              >
              </div>
              <span
                class="border-brand-400/50 text-brand-300 absolute top-6 right-3 rounded border px-1.5 py-0.5 text-[0.6rem]"
                >{demo.video.faceOverlay}</span
              >
            </div>
            <div
              class="absolute inset-0 hidden"
              data-demo-overlay="plate"
              aria-hidden="true"
            >
              <div
                class="border-signal-400/70 bg-signal-400/15 absolute bottom-4 left-1/2 h-8 w-16 -translate-x-1/2 rounded-sm border"
              >
              </div>
              <span
                class="bg-signal-400 text-ink-950 absolute bottom-5 left-1/2 -translate-x-1/2 rounded px-1 text-[0.55rem] font-semibold"
                >{demo.video.plateOverlay}</span
              >
            </div>
          </div>

          <div
            class="w-[4.6rem] shrink-0 rounded-[1.1rem] border border-white/10 bg-[#05080d] px-1.5 pt-2 pb-1.5"
            aria-hidden="true"
          >
            <div class="mx-auto mb-1 h-1 w-6 rounded-full bg-white/15"></div>
            <div
              class="min-h-24 rounded-lg border border-white/8 bg-[#111823] px-1.5 py-2"
            >
              <p
                class="text-brand-300 text-[0.55rem] leading-tight font-semibold"
                data-demo-app-title
              >
                {demo.video.appTitle}
              </p>
              <p
                class="text-ink-400 mt-1 text-[0.55rem] leading-snug"
                data-demo-app-body
              >
                {demo.video.appIdle}
              </p>
            </div>
          </div>
        </div>

        <div class="mt-3 flex flex-wrap gap-2">
          <button
            type="button"
            class="glass hover:border-brand-400/40 min-h-11 rounded-full px-3.5 text-xs font-semibold"
            data-demo-detect="person"
          >
            {demo.video.person}
          </button>
          <button
            type="button"
            class="glass hover:border-brand-400/40 min-h-11 rounded-full px-3.5 text-xs font-semibold"
            data-demo-detect="face"
          >
            {demo.video.face}
          </button>
          <button
            type="button"
            class="glass hover:border-brand-400/40 min-h-11 rounded-full px-3.5 text-xs font-semibold"
            data-demo-detect="plate"
          >
            {demo.video.plate}
          </button>
          <button
            type="button"
            class="glass hover:border-brand-400/40 min-h-11 rounded-full px-3.5 text-xs font-semibold"
            data-demo-camera
          >
            {demo.house.camera}
          </button>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .demo-stage {
    overflow: hidden;
  }

  .demo-scene {
    position: relative;
    padding: 0.4rem 0.2rem 0.2rem;
  }

  .demo-model {
    position: relative;
    width: min(100%, 22rem);
    margin-inline: auto;
  }

  .demo-house-svg {
    display: block;
    width: 100%;
    height: auto;
  }

  .demo-door,
  .demo-window,
  .demo-camera {
    position: absolute;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: pointer;
  }

  .demo-door,
  .demo-window {
    transform-style: preserve-3d;
    perspective: 420px;
  }

  .demo-door {
    left: 22.8%;
    top: 62.4%;
    width: 11%;
    height: 26%;
  }

  .demo-window {
    left: 46.6%;
    top: 61.7%;
    width: 13.2%;
    height: 13.6%;
  }

  .demo-camera {
    left: 57.6%;
    top: 49.2%;
    width: 6.4%;
    height: 4.2%;
    border-radius: 0.2rem;
    background: #111823;
    border: 1px solid #1eeff2;
  }

  .demo-camera::after {
    content: "";
    position: absolute;
    top: 50%;
    right: 0.12rem;
    width: 0.32rem;
    height: 0.32rem;
    border-radius: 999px;
    background: #1eeff2;
    transform: translateY(-50%);
  }

  .demo-opening {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, #1eeff2 0%, #0a3a40 100%);
    opacity: 0.75;
    box-shadow: inset 0 0 12px rgb(30 239 242 / 0.45);
  }

  .demo-leaf {
    position: absolute;
    inset: 0;
    transform-origin: left center;
    transform-style: preserve-3d;
    transition: transform 0.55s var(--ease-out-expo);
    box-shadow: 0 10px 18px rgb(0 0 0 / 0.4);
  }

  .demo-leaf::before {
    content: "";
    position: absolute;
    top: 0;
    left: 100%;
    width: 0.42rem;
    height: 100%;
    background: #0a0f17;
    transform: rotateY(90deg);
    transform-origin: left center;
  }

  .demo-door-leaf {
    background: linear-gradient(90deg, #141b26 0%, #243044 70%, #1b2430 100%);
    border: 2px solid #5cf1f7;
  }

  .demo-door-leaf::after {
    content: "";
    position: absolute;
    top: 50%;
    right: 0.28rem;
    width: 0.28rem;
    height: 0.28rem;
    border-radius: 999px;
    background: #1eeff2;
    transform: translateY(-50%);
  }

  .demo-window-leaf {
    background:
      linear-gradient(rgb(92 241 247 / 0.55), rgb(92 241 247 / 0.55)) center / 1px 100%
        no-repeat,
      linear-gradient(rgb(92 241 247 / 0.55), rgb(92 241 247 / 0.55)) center / 100% 1px
        no-repeat,
      linear-gradient(180deg, rgb(30 239 242 / 0.28), #0e3a42);
    border: 2px solid #5cf1f7;
  }

  [data-alarm-demo][data-door-open] .demo-door-leaf {
    transform: rotateY(76deg);
  }

  [data-alarm-demo][data-window-open] .demo-window-leaf {
    transform: rotateY(68deg);
  }

  [data-alarm-demo][data-alarm] .demo-siren rect {
    stroke: #ffb545;
  }

  [data-alarm-demo][data-alarm] .demo-siren-glow {
    fill: #ffb545;
  }

  [data-alarm-demo][data-sending] .demo-tx rect,
  [data-alarm-demo][data-sending] .demo-tx path {
    stroke: #1eeff2;
  }

  [data-alarm-demo][data-alarm] [data-demo-status-wrap] {
    color: var(--color-signal-400);
    border-color: rgb(255 181 69 / 0.4);
    background: rgb(255 181 69 / 0.12);
  }

  [data-demo-tab][aria-selected="true"] {
    background: var(--color-brand-400);
    color: var(--color-ink-950);
  }

  @media (prefers-reduced-motion: reduce) {
    .demo-leaf {
      transition: none;
    }
  }
</style>
