---
import { demo } from "../data/site";
---

<div
  class="glass relative rounded-[1.75rem] p-5 shadow-2xl shadow-black/40 sm:p-6"
  data-parallax="0.05"
  data-alarm-demo
  data-copy={JSON.stringify(demo)}
>
  <div class="flex items-start justify-between gap-3">
    <div class="min-w-0">
      <p class="text-ink-500 text-xs font-medium tracking-widest uppercase">
        {demo.label}
      </p>
      <p class="font-display mt-1 text-xl font-semibold">{demo.title}</p>
    </div>
    <span
      class="text-brand-300 border-brand-400/25 bg-brand-400/10 relative inline-flex shrink-0 items-center gap-2 rounded-full border px-3 py-1.5 text-xs font-semibold"
      data-demo-status-wrap
    >
      <span class="relative flex size-2">
        <span
          class="bg-brand-400 absolute inline-flex size-full rounded-full"
          data-demo-status-ring
          style="animation: pulse-ring 2s ease-out infinite"></span>
        <span class="bg-brand-400 relative inline-flex size-2 rounded-full"></span>
      </span>
      <span data-demo-status>{demo.status.disarmed}</span>
    </span>
  </div>

  <p class="text-ink-500 mt-3 text-xs">{demo.hint}</p>

  <div
    class="mt-4 grid grid-cols-2 gap-1 rounded-full border border-white/8 bg-white/3 p-1"
    role="tablist"
    aria-label="Demo-Ansicht"
  >
    <button
      type="button"
      role="tab"
      id="demo-tab-alarm"
      aria-controls="demo-panel-alarm"
      aria-selected="true"
      class="min-h-11 rounded-full px-3 text-sm font-semibold"
      data-demo-tab="alarm"
    >
      {demo.tabs.alarm}
    </button>
    <button
      type="button"
      role="tab"
      id="demo-tab-video"
      aria-controls="demo-panel-video"
      aria-selected="false"
      class="text-ink-400 min-h-11 rounded-full px-3 text-sm font-semibold"
      data-demo-tab="video"
    >
      {demo.tabs.video}
    </button>
  </div>

  <div class="mt-5 grid items-start gap-5 sm:grid-cols-2 sm:gap-4">
    <div>
      <div
        class="demo-stage relative rounded-2xl border border-white/10 bg-[#0c121c]"
        data-demo-house
      >
        <div
          class="demo-scene"
          role="img"
          aria-label="Dreidimensionales Haus. Tür und Fenster sind anklickbar."
        >
          <div class="demo-ground" aria-hidden="true"></div>
          <div class="demo-house">
            <div class="demo-roof" aria-hidden="true"></div>
            <div class="demo-roof-side" aria-hidden="true"></div>
            <div class="demo-side" data-demo-tx>
              <span class="demo-tx"></span>
            </div>
            <div class="demo-front">
              <button
                type="button"
                class="demo-door"
                data-demo-door
                aria-pressed="false"
                aria-label={demo.house.doorClosed}
              >
                <span class="demo-opening" aria-hidden="true"></span>
                <span class="demo-leaf demo-door-leaf" data-door-leaf></span>
              </button>
              <button
                type="button"
                class="demo-window"
                data-demo-window
                aria-pressed="false"
                aria-label={demo.house.windowClosed}
              >
                <span class="demo-opening" aria-hidden="true"></span>
                <span class="demo-leaf demo-window-leaf" data-window-leaf></span>
              </button>
              <span class="demo-siren" data-demo-siren aria-hidden="true"></span>
              <button
                type="button"
                class="demo-camera"
                data-demo-camera
                aria-label={demo.house.camera}
              >
              </button>
            </div>
          </div>
        </div>
      </div>

      <div class="mt-3 flex flex-wrap gap-2">
        <button
          type="button"
          class="glass hover:border-brand-400/40 min-h-11 rounded-full px-3.5 text-xs font-semibold"
          data-demo-door
          aria-pressed="false"
        >
          {demo.house.doorClosed}
        </button>
        <button
          type="button"
          class="glass hover:border-brand-400/40 min-h-11 rounded-full px-3.5 text-xs font-semibold"
          data-demo-window
          aria-pressed="false"
        >
          {demo.house.windowClosed}
        </button>
      </div>

      <p class="text-ink-500 mt-3 flex flex-wrap gap-x-3 gap-y-1 text-[0.7rem]">
        <span data-demo-siren-label>{demo.house.sirenIdle}</span>
        <span data-demo-tx-label>{demo.house.txIdle}</span>
      </p>
    </div>

    <div>
      <div id="demo-panel-alarm" role="tabpanel" aria-labelledby="demo-tab-alarm">
        <button
          type="button"
          class="bg-brand-400 text-ink-950 min-h-11 w-full rounded-full px-4 text-sm font-semibold"
          data-demo-arm
          aria-pressed="false"
        >
          {demo.arm}
        </button>

        <p
          class="text-ink-500 mt-4 text-[0.7rem] font-semibold tracking-widest uppercase"
        >
          Meldungen
        </p>
        <ul
          class="mt-2 max-h-40 space-y-1.5 overflow-y-auto pr-1"
          data-demo-log
          aria-live="polite"
        >
          <li class="text-ink-500 text-xs leading-relaxed">{demo.logEmpty}</li>
        </ul>

        <button
          type="button"
          class="glass mt-3 hidden min-h-11 w-full rounded-full px-4 text-sm font-semibold"
          data-demo-ack
        >
          {demo.ack}
        </button>
      </div>

      <div
        id="demo-panel-video"
        class="hidden"
        role="tabpanel"
        aria-labelledby="demo-tab-video"
        hidden
      >
        <div class="grid grid-cols-[1fr_auto] items-start gap-3">
          <div
            class="relative aspect-[4/3] overflow-hidden rounded-2xl border border-white/8 bg-[#0a0f17]"
            data-demo-live
          >
            <div
              class="from-brand-400/15 absolute inset-0 bg-linear-to-b to-transparent"
            >
            </div>
            <p
              class="text-ink-500 absolute top-2 left-2 text-[0.65rem] tracking-widest uppercase"
            >
              {demo.video.live}
            </p>
            <p
              class="text-ink-400 absolute inset-x-3 bottom-3 text-center text-[0.7rem] leading-relaxed"
              data-demo-live-caption
            >
              {demo.video.idle}
            </p>
            <div
              class="absolute inset-0 hidden"
              data-demo-overlay="person"
              aria-hidden="true"
            >
              <div
                class="border-brand-400/70 bg-brand-400/20 absolute bottom-5 left-1/2 h-16 w-10 -translate-x-1/2 rounded-t-full border"
              >
              </div>
              <span
                class="border-brand-400/50 text-brand-300 absolute top-8 left-3 rounded border px-1.5 py-0.5 text-[0.6rem]"
                >{demo.video.personOverlay}</span
              >
            </div>
            <div
              class="absolute inset-0 hidden"
              data-demo-overlay="face"
              aria-hidden="true"
            >
              <div
                class="border-brand-400/80 absolute top-8 left-1/2 size-12 -translate-x-1/2 rounded-full border-2"
              >
              </div>
              <span
                class="border-brand-400/50 text-brand-300 absolute top-6 right-3 rounded border px-1.5 py-0.5 text-[0.6rem]"
                >{demo.video.faceOverlay}</span
              >
            </div>
            <div
              class="absolute inset-0 hidden"
              data-demo-overlay="plate"
              aria-hidden="true"
            >
              <div
                class="border-signal-400/70 bg-signal-400/15 absolute bottom-4 left-1/2 h-8 w-16 -translate-x-1/2 rounded-sm border"
              >
              </div>
              <span
                class="bg-signal-400 text-ink-950 absolute bottom-5 left-1/2 -translate-x-1/2 rounded px-1 text-[0.55rem] font-semibold"
                >{demo.video.plateOverlay}</span
              >
            </div>
          </div>

          <div
            class="w-[4.6rem] shrink-0 rounded-[1.1rem] border border-white/10 bg-[#05080d] px-1.5 pt-2 pb-1.5"
            aria-hidden="true"
          >
            <div class="mx-auto mb-1 h-1 w-6 rounded-full bg-white/15"></div>
            <div
              class="min-h-24 rounded-lg border border-white/8 bg-[#111823] px-1.5 py-2"
            >
              <p
                class="text-brand-300 text-[0.55rem] leading-tight font-semibold"
                data-demo-app-title
              >
                {demo.video.appTitle}
              </p>
              <p
                class="text-ink-400 mt-1 text-[0.55rem] leading-snug"
                data-demo-app-body
              >
                {demo.video.appIdle}
              </p>
            </div>
          </div>
        </div>

        <div class="mt-3 flex flex-wrap gap-2">
          <button
            type="button"
            class="glass hover:border-brand-400/40 min-h-11 rounded-full px-3.5 text-xs font-semibold"
            data-demo-detect="person"
          >
            {demo.video.person}
          </button>
          <button
            type="button"
            class="glass hover:border-brand-400/40 min-h-11 rounded-full px-3.5 text-xs font-semibold"
            data-demo-detect="face"
          >
            {demo.video.face}
          </button>
          <button
            type="button"
            class="glass hover:border-brand-400/40 min-h-11 rounded-full px-3.5 text-xs font-semibold"
            data-demo-detect="plate"
          >
            {demo.video.plate}
          </button>
          <button
            type="button"
            class="glass hover:border-brand-400/40 min-h-11 rounded-full px-3.5 text-xs font-semibold"
            data-demo-camera
          >
            {demo.house.camera}
          </button>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .demo-stage {
    --hw: 9.75rem;
    --hd: 5.75rem;
    --hh: 7.25rem;
    overflow: visible;
  }

  .demo-scene {
    position: relative;
    height: 15.5rem;
    perspective: 880px;
    perspective-origin: 46% 42%;
  }

  .demo-ground {
    position: absolute;
    inset-inline: 12%;
    bottom: 1.15rem;
    height: 2.4rem;
    border-radius: 50%;
    background: radial-gradient(ellipse, rgb(0 0 0 / 0.55), transparent 72%);
    transform: rotateX(68deg);
  }

  .demo-house {
    position: absolute;
    top: 3.1rem;
    left: 50%;
    width: var(--hw);
    height: var(--hh);
    margin-left: calc(var(--hw) / -2);
    transform: rotateX(16deg) rotateY(-32deg);
    transform-style: preserve-3d;
  }

  .demo-front,
  .demo-side,
  .demo-roof,
  .demo-roof-side {
    position: absolute;
    transform-style: preserve-3d;
  }

  .demo-front {
    inset: 0;
    background: linear-gradient(180deg, #6b7d94 0%, #3d4b5e 58%, #2a3546 100%);
    border: 1px solid rgb(92 241 247 / 0.28);
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.12);
    transform: translateZ(calc(var(--hd) / 2));
  }

  .demo-side {
    top: 0;
    left: 50%;
    width: var(--hd);
    height: var(--hh);
    margin-left: calc(var(--hd) / -2);
    background: linear-gradient(180deg, #3f4d61 0%, #1c2532 100%);
    border: 1px solid rgb(255 255 255 / 0.08);
    transform: rotateY(90deg) translateZ(calc(var(--hw) / 2));
  }

  .demo-roof {
    left: -0.45rem;
    top: -2.55rem;
    width: calc(var(--hw) + 0.9rem);
    height: 5.1rem;
    background: linear-gradient(180deg, #8ea0b8 0%, #4c5d73 55%, #2b384a 100%);
    border: 1px solid rgb(92 241 247 / 0.22);
    transform-origin: bottom center;
    transform: translateZ(calc(var(--hd) / 2)) rotateX(64deg);
  }

  .demo-roof-side {
    left: calc(50% - 0.15rem);
    top: -2.55rem;
    width: calc(var(--hd) + 0.5rem);
    height: 5.1rem;
    margin-left: calc((var(--hd) + 0.5rem) / -2);
    background: linear-gradient(180deg, #5a6b82 0%, #243140 100%);
    border: 1px solid rgb(255 255 255 / 0.06);
    transform-origin: bottom center;
    transform: rotateY(90deg) translateZ(calc(var(--hw) / 2)) rotateX(64deg);
  }

  .demo-door,
  .demo-window,
  .demo-camera {
    padding: 0;
    border: 0;
    background: transparent;
    cursor: pointer;
  }

  .demo-door,
  .demo-window {
    position: absolute;
    transform-style: preserve-3d;
  }

  .demo-door {
    left: 0.85rem;
    bottom: 0;
    width: 2.15rem;
    height: 3.85rem;
  }

  .demo-window {
    right: 0.85rem;
    top: 1.35rem;
    width: 2.55rem;
    height: 2.15rem;
  }

  .demo-opening {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, #1eeff2 0%, #0a3a40 100%);
    opacity: 0.35;
    box-shadow: inset 0 0 12px rgb(30 239 242 / 0.45);
  }

  .demo-leaf {
    position: absolute;
    inset: 0;
    transform-origin: left center;
    transition: transform 0.5s var(--ease-out-expo);
    box-shadow: 0 8px 16px rgb(0 0 0 / 0.35);
  }

  .demo-door-leaf {
    background: linear-gradient(90deg, #141b26 0%, #243044 70%, #1b2430 100%);
    border: 2px solid #5cf1f7;
  }

  .demo-door-leaf::after {
    content: "";
    position: absolute;
    top: 50%;
    right: 0.28rem;
    width: 0.28rem;
    height: 0.28rem;
    border-radius: 999px;
    background: #1eeff2;
    transform: translateY(-50%);
  }

  .demo-window-leaf {
    background: linear-gradient(180deg, rgb(30 239 242 / 0.28), #0e3a42);
    border: 2px solid #5cf1f7;
  }

  .demo-window-leaf::before,
  .demo-window-leaf::after {
    content: "";
    position: absolute;
    background: rgb(92 241 247 / 0.55);
  }

  .demo-window-leaf::before {
    inset: 0 auto 0 50%;
    width: 1px;
  }

  .demo-window-leaf::after {
    inset: 50% 0 auto;
    height: 1px;
  }

  [data-alarm-demo][data-door-open] .demo-door-leaf {
    transform: rotateY(-78deg);
  }

  [data-alarm-demo][data-window-open] .demo-window-leaf {
    transform: rotateY(-70deg);
  }

  .demo-siren {
    position: absolute;
    top: 1.05rem;
    left: -0.55rem;
    width: 0.85rem;
    height: 0.7rem;
    border-radius: 0.2rem;
    background: #111823;
    border: 1px solid #1eeff2;
    box-shadow: 0 0 10px rgb(30 239 242 / 0.25);
    transform: translateZ(0.35rem);
  }

  .demo-siren::after {
    content: "";
    position: absolute;
    inset: -0.35rem 0.1rem auto;
    height: 0.35rem;
    border-radius: 50% 50% 0 0;
    background: rgb(30 239 242 / 0.55);
  }

  .demo-tx {
    position: absolute;
    right: 0.7rem;
    bottom: 1.2rem;
    width: 0.85rem;
    height: 1.15rem;
    border-radius: 0.15rem;
    background: #111823;
    border: 1px solid #8a97a6;
    transform: translateZ(0.2rem);
  }

  .demo-tx::before {
    content: "";
    position: absolute;
    left: 50%;
    bottom: 100%;
    width: 1px;
    height: 0.55rem;
    background: #8a97a6;
  }

  .demo-camera {
    position: absolute;
    top: -0.15rem;
    right: 0.7rem;
    width: 1.15rem;
    height: 0.7rem;
    border-radius: 0.2rem;
    background: #111823;
    border: 1px solid #1eeff2;
    transform: translateZ(0.4rem);
  }

  .demo-camera::after {
    content: "";
    position: absolute;
    top: 50%;
    right: 0.12rem;
    width: 0.32rem;
    height: 0.32rem;
    border-radius: 999px;
    background: #1eeff2;
    transform: translateY(-50%);
  }

  [data-alarm-demo][data-alarm] .demo-siren {
    border-color: #ffb545;
    box-shadow: 0 0 16px rgb(255 181 69 / 0.7);
  }

  [data-alarm-demo][data-alarm] .demo-siren::after {
    background: #ffb545;
  }

  [data-alarm-demo][data-sending] .demo-tx {
    border-color: #1eeff2;
    box-shadow: 0 0 12px rgb(30 239 242 / 0.55);
  }

  [data-alarm-demo][data-sending] .demo-tx::before {
    background: #1eeff2;
  }

  [data-alarm-demo][data-alarm] [data-demo-status-wrap] {
    color: var(--color-signal-400);
    border-color: rgb(255 181 69 / 0.4);
    background: rgb(255 181 69 / 0.12);
  }

  [data-demo-tab][aria-selected="true"] {
    background: var(--color-brand-400);
    color: var(--color-ink-950);
  }

  @media (prefers-reduced-motion: reduce) {
    .demo-leaf {
      transition: none;
    }
  }
</style>
