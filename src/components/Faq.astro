---
import { faqs } from "../data/site";

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((item) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: { "@type": "Answer", text: item.a },
  })),
};
---

{
  faqs.length > 0 && (
    <section id="faq" class="relative scroll-mt-24 py-24 md:py-32">
      <div class="container-x">
        <div class="grid gap-12 lg:grid-cols-[0.8fr_1.2fr] lg:gap-20">
          <div class="lg:sticky lg:top-32 lg:self-start">
            <p class="eyebrow" data-reveal>
              FAQ
            </p>
            <h2
              class="mt-5 text-[clamp(2rem,4.5vw,3.5rem)] leading-[1.05] font-bold"
              data-reveal
              style="--reveal-delay:80ms"
            >
              Häufige <span class="text-highlight">Fragen</span>.
            </h2>
            <p
              class="text-ink-400 mt-6 leading-relaxed"
              data-reveal
              style="--reveal-delay:160ms"
            >
              Noch etwas offen? Schreib uns.
            </p>
          </div>

          <div data-faq class="divide-y divide-white/8 border-y border-white/8">
            {faqs.map((item, i) => (
              <details
                class="group py-1"
                data-reveal
                style={`--reveal-delay:${i * 60}ms`}
              >
                <summary class="flex cursor-pointer list-none items-center justify-between gap-6 py-5 text-left [&::-webkit-details-marker]:hidden">
                  <h3 class="font-display group-hover:text-brand-300 text-lg font-semibold transition-colors sm:text-xl">
                    {item.q}
                  </h3>
                  <span
                    class="text-brand-400 group-open:border-brand-400/40 relative inline-flex size-9 shrink-0 items-center justify-center rounded-full border border-white/10 transition-all duration-300 group-open:rotate-45"
                    aria-hidden="true"
                  >
                    <svg
                      viewBox="0 0 24 24"
                      class="size-4"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                    >
                      <path d="M12 5v14M5 12h14" />
                    </svg>
                  </span>
                </summary>
                <p class="text-ink-400 max-w-2xl pr-14 pb-6 leading-relaxed">
                  {item.a}
                </p>
              </details>
            ))}
          </div>
        </div>
      </div>

      <script
        is:inline
        type="application/ld+json"
        set:html={JSON.stringify(faqSchema)}
      />
    </section>
  )
}

<style>
  details summary::marker {
    content: "";
  }

  details[open] > p {
    animation: faq-in 0.45s cubic-bezier(0.16, 1, 0.3, 1);
  }

  @keyframes faq-in {
    from {
      opacity: 0;
      transform: translateY(-0.5rem);
    }
  }
</style>
