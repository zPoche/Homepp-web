---
import "@fontsource-variable/outfit";
import "@fontsource-variable/inter";
import "../styles/global.css";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import { site, services } from "../data/site";

interface Props {
  title?: string;
  description?: string;
  /** Auf Unterseiten wie Impressum nicht indexrelevante Strukturdaten weglassen */
  structuredData?: boolean;
  noindex?: boolean;
}

const {
  title,
  description = site.description,
  structuredData = false,
  noindex = false,
} = Astro.props;

const pageTitle = title
  ? `${title} | ${site.name}`
  : site.tagline
    ? `${site.name} · ${site.tagline}`
    : site.name;
const canonical = new URL(Astro.url.pathname, Astro.site ?? site.url).href;
const ogImage = new URL("/og.png", Astro.site ?? site.url).href;

const organization: Record<string, unknown> = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": `${site.url}/#organization`,
  name: site.name,
  url: site.url,
  image: ogImage,
};

if (site.description) organization.description = site.description;
if (site.phone) organization.telephone = site.phone;
if (site.email) organization.email = site.email;
if (site.street && site.city) {
  organization.address = {
    "@type": "PostalAddress",
    streetAddress: site.street,
    postalCode: site.postalCode,
    addressLocality: site.city,
    addressCountry: site.country,
  };
}
if (site.geo.lat && site.geo.lng) {
  organization.geo = {
    "@type": "GeoCoordinates",
    latitude: site.geo.lat,
    longitude: site.geo.lng,
  };
}
if (site.areaServed.length) {
  organization.areaServed = site.areaServed.map((n) => ({
    "@type": "City",
    name: n,
  }));
}
if (services.length) {
  organization.hasOfferCatalog = {
    "@type": "OfferCatalog",
    name: "Leistungen",
    itemListElement: services.map((s) => ({
      "@type": "Offer",
      itemOffered: { "@type": "Service", name: s.title, description: s.teaser },
    })),
  };
}
---

<!doctype html>
<html lang="de" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#05080d" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="de_DE" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    {
      site.city && (
        <>
          <meta name="geo.placename" content={site.city} />
        </>
      )
    }

    {
      structuredData && (
        <script
          is:inline
          type="application/ld+json"
          set:html={JSON.stringify(organization)}
        />
      )
    }
  </head>
  <body class="antialiased">
    <a
      href="#main"
      class="focus:bg-brand-400 focus:text-ink-950 sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[100] focus:rounded-lg focus:px-4 focus:py-2 focus:font-semibold"
    >
      Zum Inhalt springen
    </a>

    <Nav />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <script>
      import "../scripts/motion";
    </script>
  </body>
</html>
