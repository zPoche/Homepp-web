---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";

interface Props {
  title: string;
  description?: string;
  intro?: string;
  updated?: string;
}

const { title, description, intro, updated } = Astro.props;
---

<Base title={title} description={description} noindex>
  <div class="relative overflow-hidden pt-[calc(var(--nav-h)+4rem)] pb-24">
    <div
      class="absolute inset-0 -z-10 bg-[radial-gradient(ellipse_70%_50%_at_50%_-20%,rgba(30,239,242,0.14),transparent_70%)]"
      aria-hidden="true"
    >
    </div>
    <div class="grid-lines absolute inset-0 -z-20 opacity-40" aria-hidden="true"></div>

    <div class="container-x">
      <a
        href="/"
        class="text-ink-500 hover:text-brand-300 group inline-flex items-center gap-2 text-sm font-medium transition-colors"
      >
        <Icon
          name="arrow"
          class="size-4 rotate-180 transition-transform duration-300 group-hover:-translate-x-1"
        />
        Zur Startseite
      </a>

      <h1 class="mt-8 text-[clamp(2.25rem,5vw,3.5rem)] leading-[1.05] font-bold">
        {title}
      </h1>
      {
        intro && (
          <p class="text-ink-400 mt-5 max-w-2xl text-lg leading-relaxed">{intro}</p>
        )
      }
      {updated && <p class="text-ink-500 mt-4 text-sm">Stand: {updated}</p>}

      <div class="prose-legal mt-14 max-w-3xl">
        <slot />
      </div>
    </div>
  </div>
</Base>

<style is:global>
  .prose-legal h2 {
    font-size: 1.5rem;
    font-weight: 600;
    margin-top: 3rem;
    margin-bottom: 1rem;
    color: var(--color-ink-50);
  }

  .prose-legal h2:first-child {
    margin-top: 0;
  }

  .prose-legal h3 {
    font-size: 1.125rem;
    font-weight: 600;
    margin-top: 2rem;
    margin-bottom: 0.65rem;
    color: var(--color-brand-300);
  }

  .prose-legal p,
  .prose-legal li {
    color: var(--color-ink-400);
    line-height: 1.75;
  }

  .prose-legal p {
    margin-bottom: 1rem;
  }

  .prose-legal ul {
    list-style: none;
    margin-bottom: 1.25rem;
    padding-left: 0;
  }

  .prose-legal ul li {
    position: relative;
    padding-left: 1.4rem;
    margin-bottom: 0.5rem;
  }

  .prose-legal ul li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.7em;
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 999px;
    background: var(--color-brand-400);
    opacity: 0.7;
  }

  .prose-legal a {
    color: var(--color-brand-300);
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .prose-legal a:hover {
    color: var(--color-brand-200);
  }

  .prose-legal strong {
    color: var(--color-ink-50);
    font-weight: 600;
  }

  /* Noch auszufüllende Pflichtangaben deutlich sichtbar machen */
  .prose-legal .todo {
    display: inline-block;
    border-radius: 0.375rem;
    background: rgb(255 181 69 / 0.14);
    border: 1px dashed rgb(255 181 69 / 0.5);
    color: var(--color-signal-400);
    padding: 0.1rem 0.5rem;
    font-size: 0.875rem;
    font-weight: 600;
  }
</style>
