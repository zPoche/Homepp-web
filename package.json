{
  "name": "homepp-web",
  "description": "Website für HomePowerPlus.de – Smart Home, Netzwerk und Elektrotechnik aus Geiselwind",
  "type": "module",
  "private": true,
  "version": "1.0.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  },
  "scripts": {
    "assets": "node scripts/generate-assets.mjs",
    "predev": "npm run assets",
    "dev": "astro dev",
    "start": "astro dev",
    "prebuild": "npm run assets",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "typecheck": "astro check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:legal": "node scripts/check-legal.mjs",
    "check:legal:strict": "node scripts/check-legal.mjs --strict",
    "check:links": "node scripts/check-links.mjs",
    "check:typography": "node scripts/check-typography.mjs",
    "check:privacy": "node scripts/check-privacy.mjs",
    "check": "npm run format:check && npm run typecheck && npm run build && npm run check:links && npm run check:typography && npm run check:privacy && npm run check:legal",
    "lighthouse": "lhci autorun"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/outfit": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.1.6",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@lhci/cli": "^0.15.1",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "^6.0.3"
  }
}
